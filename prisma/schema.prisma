// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users                User[]
  products             Product[]
  shoppingLists        ShoppingList[]
  recipes              Recipe[]
  purchases            Purchase[]
  stores               Store[]
  unmatchedScrapeItems UnmatchedScrapeItem[]
}

model User {
  id           String    @id @default(cuid())
  householdId  String
  household    Household @relation(fields: [householdId], references: [id])
  email        String    @unique
  passwordHash String
  displayName  String
  createdAt    DateTime  @default(now())

  purchases Purchase[]
}

model Product {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  name        String
  brand       String?
  defaultUnit String
  category    String?
  createdAt   DateTime  @default(now())
  archivedAt  DateTime?

  shoppingListItems ShoppingListItem[]
  recipeIngredients RecipeIngredient[]
  purchaseItems     PurchaseItem[]
  priceObservations PriceObservation[]
  productMappings   ProductMapping[]

  @@unique([householdId, name, brand])
}

model Recipe {
  id           String    @id @default(cuid())
  householdId  String
  household    Household @relation(fields: [householdId], references: [id])
  name         String
  instructions String?   @db.Text
  servings     Int       @default(2)
  createdAt    DateTime  @default(now())
  archivedAt   DateTime?

  ingredients RecipeIngredient[]
}

model RecipeIngredient {
  id        String  @id @default(cuid())
  recipeId  String
  recipe    Recipe  @relation(fields: [recipeId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Float
  unit      String

  @@unique([recipeId, productId])
}

model ShoppingList {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  name        String    @default("Veckans lista")
  createdAt   DateTime  @default(now())
  archivedAt  DateTime?

  items ShoppingListItem[]
}

model ShoppingListItem {
  id             String       @id @default(cuid())
  shoppingListId String
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id])
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  quantity       Float        @default(1)
  isChecked      Boolean      @default(false)
  addedBy        String?
  createdAt      DateTime     @default(now())
}

// Ett köptillfälle / kvitto
model Purchase {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  purchasedBy String
  user        User      @relation(fields: [purchasedBy], references: [id])
  storeName   String
  purchasedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())

  items PurchaseItem[]
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Float
  unitPrice  Float
  totalPrice Float
}

model Store {
  id            String    @id @default(cuid())
  householdId   String
  household     Household @relation(fields: [householdId], references: [id])
  chain         String
  name          String
  url           String
  isEnabled     Boolean   @default(true)
  lastScrapedAt DateTime?
  createdAt     DateTime  @default(now())

  priceObservations PriceObservation[]

  @@unique([householdId, url])
}

model PriceObservation {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id])
  regularPrice Float
  memberPrice  Float?
  unit         String
  scrapedAt    DateTime @default(now())

  @@index([productId, storeId, scrapedAt])
}

// Kopplar en kedjas interna produkt-id (stabilt per kedja, oavsett butik)
// till vår egen Product.
model ProductMapping {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id])
  chain              String
  externalProductKey String
  externalName       String
  createdAt          DateTime @default(now())

  @@unique([chain, externalProductKey])
}

// Scrapade varor utan matchning ännu - väntar på manuell länkning.
model UnmatchedScrapeItem {
  id                 String    @id @default(cuid())
  householdId        String
  household          Household @relation(fields: [householdId], references: [id])
  chain              String
  externalProductKey String
  externalName       String
  lastSeenPrice      Float
  lastSeenAt         DateTime
  resolvedAt         DateTime?

  @@unique([householdId, chain, externalProductKey])
}
